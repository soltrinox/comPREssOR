# Optional local gist model (HF id or filesystem path).
# Unset => hashed n-gram embedding surrogate, d=256 (pytest / --offline).
GIST_MODEL_PATH=

# Optional sentence-transformers model for the embedding surrogate.
# Unset => hashed n-gram fallback (no downloads).
EMBED_MODEL_PATH=

# Softmax temperature for Pattern 1 vocab-space sampling.
P1_TAU=1.0

# Adapter bottleneck rank (Pattern 2).
ADAPTER_RANK=64

# File-backed mmap root (Darwin: not /dev/shm). Lab scenarios use this.
STATE_DIR=state

# IDE hooks only (also ~/.cursor/chat-compressor.env). Never put Cursor API keys there.
# CHAT_COMPRESSOR_STATE_DIR=~/.cursor/context-graphs

# Max gist slots in C_t (lab + IDE hooks).
K_MAX=32

# Graph JSON write cadence for PersistentAgentHandle.step (hooks always flush on
# preCompact / sessionStart regardless of this value).
GRAPH_FLUSH_EVERY=5

# When set to 1/true, allow Pattern-1 vocab decode string into the forward
# channel (sessionStart / sample_for) only if Jaccard(P1, hot keywords) >= 0.15.
# Default unset/false: packed HOT_SET + typed + ranked chunks only.
CHAT_COMPRESSOR_INJECT_P1=

# Token budget for packed forward text (HOT_SET → typed → ranked chunks).
# Approx chars/4; whitespace count is also logged. Hard cap remains ~8k chars.
CHAT_COMPRESSOR_FORWARD_BUDGET=1024

# Optional second producer dim for adapter training.
PRODUCER_B_DIM=128

# Live Cursor SDK scenarios (optional): set the Cursor integrations API key in a
# local .env that is never committed. Do not place that key in chat-compressor.env.

# Cross-turn inject dedup (default on). When StateNode.meta.recipient_id is set,
# the inject ledger is partitioned per recipient (CC-2); hops reset suppression
# and warmup (CC-3..CC-5). Absent recipient_id keeps session-scoped 0.2.0 behavior.
# CHAT_COMPRESSOR_CROSS_TURN_DEDUP=1

# CC-9: optional path to comPASS advisory JSON (compass-advisory/v1).
# Absolute, or relative to CHAT_COMPRESSOR_STATE_DIR / STATE_DIR.
# Default when unset: advisory/latest.json under the state root.
# Missing/stale/corrupt files are ignored (fail-open; never blocks Agent Chat).
# CHAT_COMPRESSOR_ADVISORY_PATH=advisory/latest.json

# CC-6: packing always uses metrics.estimate_tokens (chars/4). Accurate counters
# for cost are registered in chat_compressor.tokens (per tokenizer_id).

# CC-7: hop_legal() is false while pending tool state is set on the handle or
# StateNode.meta (pending_tool=true / tool_status in pending|in_flight|awaiting).

# CC-10: optional tensor quantization for StateStore blobs (default float32).
# float16 | int8 reduce transfer size; reconstruction must meet cosine budget.
# CHAT_COMPRESSOR_TENSOR_QUANT=float32
